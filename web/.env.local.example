# Public chain config (safe to expose — these end up in the browser bundle).

# Sepolia (current demo deployment)
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=Sepolia
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CONTRACT_ADDRESS=0x407A4b2eD56034c57b0473e450FEf88cbF6e9da3

# Local Hardhat (uncomment the four lines below to run `npm run deploy:local` instead)
# NEXT_PUBLIC_CHAIN_ID=31337
# NEXT_PUBLIC_CHAIN_NAME=Hardhat Local
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Server-only: key that signs step proofs. Must match the contract's `verifier`.
# Never prefix this with NEXT_PUBLIC_ — it would be shipped to the browser.
VERIFIER_PRIVATE_KEY=0x
